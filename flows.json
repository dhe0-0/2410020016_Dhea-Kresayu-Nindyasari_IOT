    {
        "id": "8f3bdae4d82a19e3",
        "type": "function",
        "z": "a0b4586d050b7bb9",
        "name": "Set Threshold",
        "func": "const apiKey = msg.req && (msg.req.headers[\"x-api-key\"] || msg.req.headers[\"X-API-Key\"]);\nconst VALID_KEY = \"rahasia123\";\n\nif (apiKey !== VALID_KEY) {\n    msg.statusCode = 401;\n    msg.payload = {\n        status: \"error\",\n        message: \"Unauthorized: X-API-Key tidak valid atau tidak ada\"\n    };\n    return msg;\n}\n\nlet body = msg.payload;\nif (typeof body === 'string') {\n    try { body = JSON.parse(body); } catch (e) { body = {}; }\n}\n\nconst batasSuhu = Number(body.max_suhu ?? body.threshold ?? body.suhu);\n\nif (Number.isNaN(batasSuhu)) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: \"error\",\n        message: \"Format salah. Kirim JSON seperti {\\\"max_suhu\\\": 32}\"\n    };\n    return msg;\n}\n\nflow.set(\"batas_suhu\", batasSuhu);\n\nmsg.statusCode = 200;\nmsg.payload = {\n    status: \"success\",\n    message: \"Batas suhu berhasil diatur\",\n    batas_suhu: batasSuhu\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1520,
        "y": 80,
