    {
        "id": "fa13d2ae191c2748",
        "type": "function",
        "z": "a0b4586d050b7bb9",
        "name": "Cek & Notif Suhu",
        "func": "let d = msg.payload;\nif (typeof d === 'string') {\n    try { d = JSON.parse(d); } catch (e) { d = {}; }\n}\n\nlet suhu = d && d.suhu !== undefined ? Number(d.suhu) : NaN;\nif (Number.isNaN(suhu)) {\n    const last = flow.get('last_sensor_raw');\n    if (last && last.suhu !== undefined) {\n        suhu = Number(last.suhu);\n    }\n}\n\nconst batasSuhu = Number(flow.get(\"batas_suhu\") ?? 32);\n\nif (!Number.isNaN(suhu) && suhu > batasSuhu) {\n    const notif = {\n        type: \"temperature_alert\",\n        status: \"warning\",\n        message: `Suhu ${suhu}°C melewati batas maksimum ${batasSuhu}°C!`,\n        suhu: suhu,\n        batas_suhu: batasSuhu,\n        timestamp: (d && d.timestamp) || new Date().toISOString()\n    };\n\n    node.warn(notif.message);\n    flow.set(\"last_alert\", notif);\n\n    msg.payload = notif;\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
