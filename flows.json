    {
        "id": "2d9d91e9ad7d0ed1",
        "type": "template",
        "z": "a0b4586d050b7bb9",
        "name": "Dashboard HTML",
        "field": "payload",
        "fieldType": "msg",
        "format": "handlebars",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Dashboard Monitoring Suhu</title>\n  <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n  <style>\n    body { font-family: Arial, sans-serif; margin: 24px; background: #111827; color: #f9fafb; }\n    .card { max-width: 960px; margin: auto; background: #1f2937; padding: 20px; border-radius: 12px; }\n    .info { display: flex; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; align-items: center; }\n    .badge { background: #374151; padding: 8px 14px; border-radius: 8px; }\n    .alert { background: #7f1d1d; color: #fecaca; padding: 10px 14px; border-radius: 8px; margin-bottom: 16px; display: none; }\n    .ws-status { font-size: 13px; color: #9ca3af; margin-bottom: 12px; }\n  </style>\n</head>\n<body>\n  <div class=\"card\">\n    <h2>Monitoring Suhu & Kelembaban (Real-Time)</h2>\n    <div id=\"wsStatus\" class=\"ws-status\">WebSocket: Menghubungkan...</div>\n    <div class=\"info\">\n      <div class=\"badge\">Suhu Terakhir: <strong id=\"suhuNow\">-</strong> °C</div>\n      <div class=\"badge\">Kelembaban: <strong id=\"humNow\">-</strong> %</div>\n      <div class=\"badge\">\n        Batas Suhu: <input id=\"batasInput\" type=\"number\" step=\"0.5\" value=\"29\" style=\"width:65px;\">\n        <button onclick=\"setBatas()\">Simpan</button>\n      </div>\n    </div>\n    <div id=\"alertBox\" class=\"alert\"></div>\n    <canvas id=\"sensorChart\" height=\"110\"></canvas>\n  </div>\n\n  <script>\n    const ctx = document.getElementById('sensorChart').getContext('2d');\n    const chart = new Chart(ctx, {\n      type: 'line',\n      data: {\n        labels: [],\n        datasets: [\n          { label: 'Suhu (°C)', data: [], borderColor: '#f87171', tension: 0.3 },\n          { label: 'Kelembaban (%)', data: [], borderColor: '#60a5fa', tension: 0.3 }\n        ]\n      },\n      options: { animation: false, scales: { y: { beginAtZero: false } } }\n    });\n\n    function updateTampilan(item) {\n      if (!item || item.suhu === undefined) return;\n      const waktu = new Date(item.received || item.timestamp || Date.now()).toLocaleTimeString();\n\n      chart.data.labels.push(waktu);\n      chart.data.datasets[0].data.push(Number(item.suhu));\n      chart.data.datasets[1].data.push(Number(item.kelembaban));\n\n      if (chart.data.labels.length > 20) {\n        chart.data.labels.shift();\n        chart.data.datasets[0].data.shift();\n        chart.data.datasets[1].data.shift();\n      }\n      chart.update();\n\n      document.getElementById('suhuNow').textContent = item.suhu;\n      document.getElementById('humNow').textContent = item.kelembaban;\n\n      const batas = Number(document.getElementById('batasInput').value || 29);\n      const alertBox = document.getElementById('alertBox');\n      if (Number(item.suhu) > batas) {\n        alertBox.style.display = 'block';\n        alertBox.textContent = `Peringatan! Suhu ${item.suhu}°C melewati batas ${batas}°C`;\n      } else {\n        alertBox.style.display = 'none';\n      }\n    }\n\n    async function muatAwal() {\n      const res = await fetch('/api/history');\n      const json = await res.json();\n      const rows = (json.data || []).slice().reverse();\n      rows.forEach(updateTampilan);\n    }\n\n    function hubungkanWS() {\n      const wsProtocol = location.protocol === 'https:' ? 'wss:' : 'ws:';\n      const ws = new WebSocket(`${wsProtocol}//${location.host}/ws/sensor`);\n      const statusEl = document.getElementById('wsStatus');\n\n      ws.onopen = () => {\n        statusEl.textContent = 'WebSocket: Terhubung (Real-time push aktif)';\n      };\n\n      ws.onmessage = (event) => {\n        let data = event.data;\n        if (typeof data === 'string') {\n          try { data = JSON.parse(data); } catch (e) { return; }\n        }\n        updateTampilan(data);\n      };\n\n      ws.onclose = () => {\n        statusEl.textContent = 'WebSocket: Terputus, mencoba hubungkan ulang...';\n        setTimeout(hubungkanWS, 2000);\n      };\n    }\n\n    async function setBatas() {\n      const val = Number(document.getElementById('batasInput').value);\n      await fetch('/api/threshold', {\n        method: 'PUT',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ max_suhu: val })\n      });\n    }\n\n    muatAwal();\n    hubungkanWS();\n  </script>\n</body>\n</html>",
