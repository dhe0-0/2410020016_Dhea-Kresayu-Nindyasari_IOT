    {
        "id": "0ee33c2c8f75fe13",
        "type": "function",
        "z": "a0b4586d050b7bb9",
        "name": "Insert Sensor Log",
        "func": "let d = msg.payload;\nif (typeof d === 'string') {\n    try { d = JSON.parse(d); } catch (e) { d = {}; }\n}\nif (!d || typeof d !== 'object') {\n    d = flow.get('last_sensor_raw') || {};\n}\n\nconst suhu = Number(d.suhu ?? 0);\nconst kelembaban = Number(d.kelembaban ?? 0);\nconst timestamp = String(d.timestamp ?? new Date().toISOString());\nconst received = String(d.received ?? new Date().toISOString());\n\nnode.warn({ dariInsertSensorLog: { suhu, kelembaban, timestamp, received } });\n\nmsg.topic = `INSERT INTO sensor_logs (suhu, kelembaban, timestamp, received) VALUES (${suhu}, ${kelembaban}, '${timestamp}', '${received}')`;\nreturn msg;",
